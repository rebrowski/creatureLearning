{
  "format": "creature_genome_schema/1",
  "notes": "Alle Gene einer Kreatur. Felder siehe docs/genome_parameters.md. Neue Gene einfach anhängen: bestehende Kreaturen behalten ihre Werte, weil jedes Gen seinen eigenen Zufalls-Seed hat.",
  "genes": [
    {
      "id": "segment_count",
      "type": "int",
      "group": "bodyplan",
      "min": 1,
      "max": 4,
      "default": 2,
      "varies_until": "order",
      "weight": 3.0,
      "description": "Anzahl der Körpersegmente (1 = kompakt, 4 = wurmartig lang)."
    },
    {
      "id": "leg_count",
      "type": "int",
      "group": "bodyplan",
      "min": 0,
      "max": 8,
      "step": 2,
      "default": 4,
      "varies_until": "order",
      "weight": 4.0,
      "description": "Anzahl der Beine, immer paarig (0, 2, 4, 6, 8)."
    },
    {
      "id": "body_shape",
      "type": "enum",
      "group": "bodyplan",
      "options": [
        "round",
        "elongated",
        "flat"
      ],
      "default": "round",
      "varies_until": "family",
      "weight": 2.0,
      "description": "Querschnitt des Körpers: rund, gestreckt oder flach."
    },
    {
      "id": "gait",
      "type": "enum",
      "group": "movement",
      "options": [
        "walk",
        "trot",
        "hop",
        "scuttle",
        "slither"
      ],
      "default": "walk",
      "varies_until": "family",
      "weight": 1.5,
      "description": "Gangart für die prozedurale Animation (ab M2)."
    },
    {
      "id": "speed",
      "type": "float",
      "group": "movement",
      "min": 0.3,
      "max": 3.0,
      "default": 1.0,
      "weight": 0.5,
      "description": "Grundtempo (Schritte pro Sekunde relativ)."
    },
    {
      "id": "posture",
      "type": "float",
      "group": "movement",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5,
      "weight": 0.8,
      "description": "Haltung: 0 = geduckt/breitbeinig, 1 = hoch aufgerichtet."
    },
    {
      "id": "body_length",
      "type": "float",
      "group": "proportion",
      "min": 0.4,
      "max": 2.0,
      "default": 1.0,
      "weight": 1.5,
      "description": "Länge des Rumpfs in Metern (ohne Kopf und Schwanz)."
    },
    {
      "id": "body_width",
      "type": "float",
      "group": "proportion",
      "min": 0.2,
      "max": 1.2,
      "default": 0.5,
      "weight": 1.0,
      "description": "Dicke des Rumpfs in Metern."
    },
    {
      "id": "head_size",
      "type": "float",
      "group": "proportion",
      "min": 0.1,
      "max": 0.7,
      "default": 0.3,
      "weight": 1.0,
      "description": "Kopfdurchmesser in Metern."
    },
    {
      "id": "leg_length",
      "type": "float",
      "group": "proportion",
      "min": 0.1,
      "max": 1.6,
      "default": 0.6,
      "weight": 1.5,
      "depends_on": "leg_count",
      "description": "Beinlänge in Metern (Ober- plus Unterschenkel)."
    },
    {
      "id": "leg_thickness",
      "type": "float",
      "group": "proportion",
      "min": 0.02,
      "max": 0.2,
      "default": 0.06,
      "weight": 0.5,
      "depends_on": "leg_count",
      "description": "Beindicke in Metern."
    },
    {
      "id": "horn_count",
      "type": "int",
      "group": "appendage",
      "min": 0,
      "max": 4,
      "default": 0,
      "varies_until": "species",
      "weight": 1.5,
      "description": "Anzahl Hörner auf dem Kopf."
    },
    {
      "id": "horn_length",
      "type": "float",
      "group": "appendage",
      "min": 0.0,
      "max": 0.8,
      "default": 0.2,
      "weight": 1.0,
      "depends_on": "horn_count",
      "description": "Hornlänge in Metern."
    },
    {
      "id": "tail_length",
      "type": "float",
      "group": "appendage",
      "min": 0.0,
      "max": 1.5,
      "default": 0.3,
      "weight": 1.0,
      "description": "Schwanzlänge in Metern (0 = kein Schwanz)."
    },
    {
      "id": "crest_height",
      "type": "float",
      "group": "appendage",
      "min": 0.0,
      "max": 0.5,
      "default": 0.0,
      "weight": 0.8,
      "description": "Höhe des Rückenkamms in Metern (0 = kein Kamm)."
    },
    {
      "id": "antenna_length",
      "type": "float",
      "group": "appendage",
      "min": 0.0,
      "max": 1.0,
      "default": 0.0,
      "weight": 0.8,
      "description": "Fühlerlänge in Metern (0 = keine Fühler)."
    },
    {
      "id": "hue",
      "type": "float",
      "group": "color",
      "min": 0.0,
      "max": 1.0,
      "default": 0.3,
      "wrap": true,
      "weight": 1.5,
      "description": "Farbton der Grundfarbe (0 = rot, 0.33 = grün, 0.66 = blau), kreisförmig."
    },
    {
      "id": "saturation",
      "type": "float",
      "group": "color",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5,
      "weight": 0.8,
      "description": "Farbsättigung der Grundfarbe."
    },
    {
      "id": "brightness",
      "type": "float",
      "group": "color",
      "min": 0.15,
      "max": 1.0,
      "default": 0.6,
      "weight": 0.8,
      "description": "Helligkeit der Grundfarbe."
    },
    {
      "id": "pattern_type",
      "type": "enum",
      "group": "pattern",
      "options": [
        "none",
        "stripes",
        "spots",
        "bands"
      ],
      "default": "none",
      "varies_until": "species",
      "weight": 1.2,
      "description": "Musterart: keins, Querstreifen, Flecken, Längsband."
    },
    {
      "id": "pattern_density",
      "type": "float",
      "group": "pattern",
      "min": 1.0,
      "max": 8.0,
      "default": 3.0,
      "weight": 0.5,
      "depends_on": "pattern_type",
      "description": "Wie viele Streifen/Flecken pro Segment."
    },
    {
      "id": "pattern_contrast",
      "type": "float",
      "group": "pattern",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5,
      "weight": 0.5,
      "depends_on": "pattern_type",
      "description": "Kontrast des Musters zur Grundfarbe."
    },
    {
      "id": "climb",
      "type": "float",
      "group": "ability",
      "min": 0.0,
      "max": 1.0,
      "default": 0.4,
      "visible": false,
      "variance_scale": 1.5,
      "weight": 1.0,
      "description": "Klettern (Fels, Baum). Unsichtbar; Grundwert der Fähigkeit vor Kopplung an sichtbare Merkmale und Kontext (data/abilities/abilities.json)."
    },
    {
      "id": "swim",
